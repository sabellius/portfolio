---
import { Icon } from 'astro-icon/components';
import { SITE_CONFIG } from '../config';
---

<footer class="bg-dark-100 text-white py-2">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-400">
        Made By Saveliy Shiryaev {new Date().getFullYear()}©
      </p>

      <div class="flex flex-wrap justify-center gap-3 sm:gap-6">
        <a
          href={SITE_CONFIG.resumeUrl}
          download
          class="flex items-center gap-2 text-gray-400 hover:bg-primary hover:text-dark-100 px-2 py-1.5 sm:px-3 sm:py-2 rounded-lg transition-colors"
          aria-label="Download Resume">
          <Icon
            name="mdi:file-document-outline"
            class="w-6 h-6 sm:w-8 sm:h-8 fill-current"
          />
          <span class="text-sm sm:text-base">Resume</span>
        </a>
        <a
          href={SITE_CONFIG.github}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-gray-400 hover:bg-primary hover:text-dark-100 px-2 py-1.5 sm:px-3 sm:py-2 rounded-lg transition-colors"
          aria-label="GitHub">
          <Icon name="mdi:github" class="w-6 h-6 sm:w-8 sm:h-8 fill-current" />
          <span class="text-sm sm:text-base">GitHub</span>
        </a>
        <a
          href={SITE_CONFIG.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-gray-400 hover:bg-primary hover:text-dark-100 px-2 py-1.5 sm:px-3 sm:py-2 rounded-lg transition-colors"
          aria-label="LinkedIn">
          <Icon
            name="mdi:linkedin"
            class="w-6 h-6 sm:w-8 sm:h-8 fill-current"
          />
          <span class="text-sm sm:text-base">LinkedIn</span>
        </a>
        <a
          href={SITE_CONFIG.email}
          class="flex items-center gap-2 text-gray-400 hover:bg-primary hover:text-dark-100 px-2 py-1.5 sm:px-3 sm:py-2 rounded-lg transition-colors"
          aria-label="Email">
          <Icon
            name="mdi:email-outline"
            class="w-6 h-6 sm:w-8 sm:h-8 fill-current"
          />
          <span class="text-sm sm:text-base">Email</span>
        </a>
      </div>
    </div>
  </div>
</footer>
