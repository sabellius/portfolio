---
import { Icon } from 'astro-icon/components';
import { SITE_CONFIG } from '../config';
---
<section id="hero" class="min-h-screen flex items-start pt-[30vh]">
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl">
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-white mb-6">
        Hi, I'm <span class="text-primary">Saveliy</span>
      </h1>
      <p class="text-2xl sm:text-3xl text-primary font-medium mb-4">
        Full-Stack Developer
      </p>
      <p class="text-lg sm:text-xl text-gray-200 mb-8 max-w-2xl">
        Shipping software that actually works, not just looks like it does.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="#projects"
          class="px-6 py-3 bg-primary text-dark-100 font-medium rounded-lg hover:bg-primary-dark transition-colors inline-flex items-center gap-2">
          View Projects
        </a>
        <a
          href={SITE_CONFIG.resumeUrl}
          download
          class="px-6 py-3 border-2 border-primary text-primary font-medium rounded-lg hover:bg-primary hover:text-dark-100 transition-colors inline-flex items-center gap-2">
          <Icon name="mdi:download" class="w-4 h-4" />
          Download Resume
        </a>
      </div>
    </div>
  </div>
</section>
