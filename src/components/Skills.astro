---
import { SKILL_CATEGORIES } from '../config';
---
<section id="skills" class="py-20 sm:py-20 bg-body">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal" data-reveal>
      <p class="section-label">Toolkit</p>
      <h2 class="section-heading">Skills</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-[640px] mt-10">
      {
        SKILL_CATEGORIES.map((category, i) => {
          const delay = i < 8 ? `reveal-delay-${i + 1}` : '';
          return (
          <div class={`reveal ${delay}`} data-reveal>
            <h3 class="text-base font-semibold text-white mb-3 pb-1.5 border-b border-glow-md">
              {category.category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {category.skills.map(skill => (
                <span class="skill-pill">
                  {skill}
                </span>
              ))}
            </div>
          </div>
          );
        })
      }
    </div>
  </div>
</section>
