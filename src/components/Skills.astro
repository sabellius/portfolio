---
import { SKILL_CATEGORIES } from '../config';
---
<section id="skills" class="py-20 sm:py-20 bg-body">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-[11px] sm:text-xs uppercase tracking-[3px] text-primary mb-2.5">Toolkit</p>
    <h2 class="text-[32px] font-bold text-white mb-3">Skills</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-[640px] mt-10">
      {
        SKILL_CATEGORIES.map(category => (
          <div>
            <h3 class="text-base font-semibold text-white mb-3 pb-1.5 border-b border-glow-md">
              {category.category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {category.skills.map(skill => (
                <span class="bg-glow-sm text-text-light px-3 py-[5px] rounded text-xs cursor-default transition-colors duration-200 ease-out hover:bg-glow-md hover:text-text-bright">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
