---
import { TIMELINE } from '../config';
---

<section id="experience" class="py-20 sm:py-40 bg-dark-400">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-4xl font-bold text-white mb-4">Experience & Education</h2>
    <p class="text-lg text-gray-300 mb-12 max-w-2xl">
      My professional background and training
    </p>

    <div class="max-w-3xl space-y-12">
      {
        TIMELINE.map(section => (
          <div>
            <h3 class="text-xl font-bold text-white mb-6">
              {section.label}
            </h3>
            <div class="space-y-8">
              {section.entries.map(entry => (
                <div class="relative pl-8 border-l-2 border-primary/30">
                  <div class="absolute left-0 top-1 w-4 h-4 -translate-x-[9px] rounded-full bg-primary" />
                  <p class="text-sm text-primary font-medium mb-1">{entry.period}</p>
                  <h4 class="text-lg font-bold text-white">{entry.title}</h4>
                  <p class="text-gray-400 mb-2">{entry.organization}</p>
                  <p class="text-gray-300">{entry.description}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
