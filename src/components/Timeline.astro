---
import { TIMELINE } from '../config';
---
<section id="experience" class="py-20 sm:py-20 bg-dark-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-[11px] sm:text-xs uppercase tracking-[3px] text-primary mb-2.5">Background</p>
    <h2 class="text-[32px] font-bold text-white mb-3">Experience & Education</h2>

    <div class="max-w-[600px] space-y-10 mt-10">
      {
        TIMELINE.map(section => (
          <div>
            <h3 class="text-lg font-semibold text-white mb-5">{section.label}</h3>
            <div>
              {section.entries.map((entry, i) => {
                const isLast = i === section.entries.length - 1;
                return (
                  <div class={`relative pl-7 pb-6 ${isLast ? 'border-l border-transparent' : 'border-l border-glow-lg'}`}>
                    <div class="absolute left-[-4px] top-1 w-[7px] h-[7px] rounded-full bg-primary" />
                    <p class="text-xs text-primary mb-1">{entry.period}</p>
                    <h4 class="text-base font-semibold text-white">{entry.title}</h4>
                    <p class="text-[13px] text-text-dim mb-1">{entry.organization}</p>
                    {entry.description && <p class="text-sm text-text-muted leading-relaxed">{entry.description}</p>}
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
