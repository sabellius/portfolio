---
import { PROJECTS } from '../config';
---
<section id="projects" class="py-20 sm:py-20 bg-dark-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-[11px] sm:text-xs uppercase tracking-[3px] text-primary mb-2.5">Work</p>
    <h2 class="text-[32px] font-bold text-white mb-3">Projects</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-[800px] mt-10">
      {
        PROJECTS.map(project => (
          <article class="bg-card border-2 border-dark-300 rounded-xl overflow-hidden transition-colors duration-200 ease-out hover:border-glow-2xl cursor-pointer flex flex-col">
            {project.image && (
              <div class="w-full">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-[180px] object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="p-5 flex flex-col flex-1">
              <h3 class="text-xl font-semibold text-white mb-1.5">{project.title}</h3>
              <p class="text-[13px] text-text-muted leading-relaxed mb-2.5">
                {project.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {project.tags.map(tag => (
                  <span class="text-xs text-text-dim">{tag.label}</span>
                ))}
              </div>
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="block mt-auto pt-3 border-t border-dark-300 text-xs text-primary transition-colors duration-200 ease-out hover:text-primary-dark">
                GitHub →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
